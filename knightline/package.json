{
  "name": "knightline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Knightline: a daily knight's-path logic puzzle.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:generate": "tsx scripts/generate-content.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:report": "tsx scripts/report.ts",
    "build:artifact": "KL_INLINE=1 vite build --outDir dist && tsx scripts/build-artifact.ts",
    "icons": "tsx scripts/render-icons.ts"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
